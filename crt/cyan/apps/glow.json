{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#5ae2e2",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#34f4d2",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#000000",
		"background_color": "#34f4d2",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#1affff"
	},
	"h3": {
		"prefix": "### ",
		"color": "#199ce6"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#199ce6"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#46b5b5"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#46b5b5",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#084c4c",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#199ce6",
		"underline": true
	},
	"link_text": {
		"color": "#34f4d2",
		"bold": true
	},
	"image": {
		"color": "#1affff",
		"underline": true
	},
	"image_text": {
		"color": "#346262",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#1affff",
		"background_color": "#031a1a"
	},
	"code_block": {
		"color": "#5ae2e2",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#5ae2e2"
			},
			"error": {
				"color": "#0bcb92",
				"background_color": "#031a1a"
			},
			"comment": {
				"color": "#346262"
			},
			"comment_preproc": {
				"color": "#1affff"
			},
			"keyword": {
				"color": "#34f4d2"
			},
			"keyword_reserved": {
				"color": "#0bcb92"
			},
			"keyword_namespace": {
				"color": "#52e0ff"
			},
			"keyword_type": {
				"color": "#1694ca"
			},
			"operator": {
				"color": "#46b5b5"
			},
			"punctuation": {
				"color": "#567c7c"
			},
			"name": {
				"color": "#5ae2e2"
			},
			"name_builtin": {
				"color": "#52e0ff"
			},
			"name_tag": {
				"color": "#34f4d2"
			},
			"name_attribute": {
				"color": "#199ce6"
			},
			"name_class": {
				"color": "#1694ca",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#52e0ff"
			},
			"name_exception": {
				"color": "#0bcb92"
			},
			"name_function": {
				"color": "#199ce6"
			},
			"name_other": {
				"color": "#5ae2e2"
			},
			"literal": {
				"color": "#46b5b5"
			},
			"literal_number": {
				"color": "#52e0ff"
			},
			"literal_date": {
				"color": "#46b5b5"
			},
			"literal_string": {
				"color": "#00c2c2"
			},
			"literal_string_escape": {
				"color": "#1affff"
			},
			"generic_deleted": {
				"color": "#0bcb92"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#00c2c2"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#567c7c"
			},
			"background": {
				"background_color": "#020f0f"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
