{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#e2b05a",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#f48a34",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#000000",
		"background_color": "#f48a34",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#ffaa1a"
	},
	"h3": {
		"prefix": "### ",
		"color": "#e6e319"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#e6e319"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#b58d46"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#b58d46",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#4c3308",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#e6e319",
		"underline": true
	},
	"link_text": {
		"color": "#f48a34",
		"bold": true
	},
	"image": {
		"color": "#ffaa1a",
		"underline": true
	},
	"image_text": {
		"color": "#6b5b40",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#ffaa1a",
		"background_color": "#1a1103"
	},
	"code_block": {
		"color": "#e2b05a",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#e2b05a"
			},
			"error": {
				"color": "#cb4a0b",
				"background_color": "#1a1103"
			},
			"comment": {
				"color": "#6b5b40"
			},
			"comment_preproc": {
				"color": "#ffaa1a"
			},
			"keyword": {
				"color": "#f48a34"
			},
			"keyword_reserved": {
				"color": "#cb4a0b"
			},
			"keyword_namespace": {
				"color": "#ffde52"
			},
			"keyword_type": {
				"color": "#cabd16"
			},
			"operator": {
				"color": "#b58d46"
			},
			"punctuation": {
				"color": "#847760"
			},
			"name": {
				"color": "#e2b05a"
			},
			"name_builtin": {
				"color": "#ffde52"
			},
			"name_tag": {
				"color": "#f48a34"
			},
			"name_attribute": {
				"color": "#e6e319"
			},
			"name_class": {
				"color": "#cabd16",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#ffde52"
			},
			"name_exception": {
				"color": "#cb4a0b"
			},
			"name_function": {
				"color": "#e6e319"
			},
			"name_other": {
				"color": "#e2b05a"
			},
			"literal": {
				"color": "#b58d46"
			},
			"literal_number": {
				"color": "#ffde52"
			},
			"literal_date": {
				"color": "#b58d46"
			},
			"literal_string": {
				"color": "#c27a00"
			},
			"literal_string_escape": {
				"color": "#ffaa1a"
			},
			"generic_deleted": {
				"color": "#cb4a0b"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#c27a00"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#847760"
			},
			"background": {
				"background_color": "#0f0a02"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
