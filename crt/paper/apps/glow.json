{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#c9c7b8",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#9f9a88",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#000000",
		"background_color": "#9f9a88",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#f0eee0"
	},
	"h3": {
		"prefix": "### ",
		"color": "#848c73"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#848c73"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#a3a194"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#a3a194",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#484743",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#848c73",
		"underline": true
	},
	"link_text": {
		"color": "#9f9a88",
		"bold": true
	},
	"image": {
		"color": "#f0eee0",
		"underline": true
	},
	"image_text": {
		"color": "#5f5e56",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#f0eee0",
		"background_color": "#181816"
	},
	"code_block": {
		"color": "#c9c7b8",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#c9c7b8"
			},
			"error": {
				"color": "#7f786a",
				"background_color": "#181816"
			},
			"comment": {
				"color": "#5f5e56"
			},
			"comment_preproc": {
				"color": "#f0eee0"
			},
			"keyword": {
				"color": "#9f9a88"
			},
			"keyword_reserved": {
				"color": "#7f786a"
			},
			"keyword_namespace": {
				"color": "#b0b39e"
			},
			"keyword_type": {
				"color": "#757b65"
			},
			"operator": {
				"color": "#a3a194"
			},
			"punctuation": {
				"color": "#7a7a73"
			},
			"name": {
				"color": "#c9c7b8"
			},
			"name_builtin": {
				"color": "#b0b39e"
			},
			"name_tag": {
				"color": "#9f9a88"
			},
			"name_attribute": {
				"color": "#848c73"
			},
			"name_class": {
				"color": "#757b65",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#b0b39e"
			},
			"name_exception": {
				"color": "#7f786a"
			},
			"name_function": {
				"color": "#848c73"
			},
			"name_other": {
				"color": "#c9c7b8"
			},
			"literal": {
				"color": "#a3a194"
			},
			"literal_number": {
				"color": "#b0b39e"
			},
			"literal_date": {
				"color": "#a3a194"
			},
			"literal_string": {
				"color": "#7e7d69"
			},
			"literal_string_escape": {
				"color": "#f0eee0"
			},
			"generic_deleted": {
				"color": "#7f786a"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#7e7d69"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#7a7a73"
			},
			"background": {
				"background_color": "#0e0e0d"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
