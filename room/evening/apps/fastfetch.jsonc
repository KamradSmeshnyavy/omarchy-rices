// Cozy Room Evening: omarchy-themes/rices/room/build.py
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/room-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;242;178;92",
      "title": "38;2;244;227;193",
      "output": "38;2;244;227;193",
      "separator": "38;2;201;169;138"
    },
    "key": {
      "width": 9
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;242;178;92m☕ \u001b[38;2;244;227;193mзаписка на холодильнике"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;201;169;138m┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄"
    },
    {
      "type": "title",
      "key": "жилец",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "дом",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "окна",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "шёпот",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "дома уже"
    },
    {
      "type": "memory",
      "key": "на полках",
      "format": "{used} / {total}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;59;36;28m   \u001b[48;2;139;90;60m   \u001b[48;2;217;103;95m   \u001b[48;2;122;168;96m   \u001b[48;2;242;178;92m   \u001b[48;2;127;178;217m   \u001b[48;2;228;138;160m   \u001b[48;2;244;227;193m   \u001b[0m"
    }
  ]
}
