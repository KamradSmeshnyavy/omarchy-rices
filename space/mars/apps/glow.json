{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#ebdbb2",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#d3869b",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#282828",
		"background_color": "#d3869b",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#fb4934"
	},
	"h3": {
		"prefix": "### ",
		"color": "#83a598"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#83a598"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#bcaf91"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#bcaf91",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#4b4841",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#83a598",
		"underline": true
	},
	"link_text": {
		"color": "#d3869b",
		"bold": true
	},
	"image": {
		"color": "#fb5440",
		"underline": true
	},
	"image_text": {
		"color": "#807871",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#fb5440",
		"background_color": "#3c3a36"
	},
	"code_block": {
		"color": "#ebdbb2",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#ebdbb2"
			},
			"error": {
				"color": "#fb5440",
				"background_color": "#3c3a36"
			},
			"comment": {
				"color": "#807871"
			},
			"comment_preproc": {
				"color": "#fb5440"
			},
			"keyword": {
				"color": "#d3869b"
			},
			"keyword_reserved": {
				"color": "#fb5440"
			},
			"keyword_namespace": {
				"color": "#fabd2f"
			},
			"keyword_type": {
				"color": "#8ec07c"
			},
			"operator": {
				"color": "#bcaf91"
			},
			"punctuation": {
				"color": "#968f8a"
			},
			"name": {
				"color": "#ebdbb2"
			},
			"name_builtin": {
				"color": "#fabd2f"
			},
			"name_tag": {
				"color": "#d3869b"
			},
			"name_attribute": {
				"color": "#83a598"
			},
			"name_class": {
				"color": "#8ec07c",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#fabd2f"
			},
			"name_exception": {
				"color": "#fb5440"
			},
			"name_function": {
				"color": "#83a598"
			},
			"name_other": {
				"color": "#ebdbb2"
			},
			"literal": {
				"color": "#bcaf91"
			},
			"literal_number": {
				"color": "#fabd2f"
			},
			"literal_date": {
				"color": "#bcaf91"
			},
			"literal_string": {
				"color": "#b8bb26"
			},
			"literal_string_escape": {
				"color": "#fb5440"
			},
			"generic_deleted": {
				"color": "#fb5440"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#b8bb26"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#968f8a"
			},
			"background": {
				"background_color": "#32312f"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
