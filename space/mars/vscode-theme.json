  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#807871",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "scope": [
        "keyword.control.flow",
        "keyword.control.return"
      ],
      "settings": {
        "foreground": "#d3869b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#fb5440"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#fabd2f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#83a598"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "entity.other.attribute-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#bcaf91"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#ebdbb2"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#ebdbb2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#d3869b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#968f8a"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "entity.name.function.macro",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#fb5440"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#fb4934",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ebdbb2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ebdbb2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#83a598",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.list.unnumbered",
        "markup.list.numbered",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#968f8a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#fb5440"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#83a598"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#fb5440"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#8ec07c",
      "fontStyle": ""
    },
    "interface": {
      "foreground": "#8ec07c",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#8ec07c",
      "fontStyle": ""
    },
    "struct": {
      "foreground": "#8ec07c",
      "fontStyle": ""
    },
    "type": {
      "foreground": "#8ec07c",
      "fontStyle": ""
    },
    "typeParameter": {
      "foreground": "#8ec07c",
      "fontStyle": "italic"
    },
    "namespace": "#8ec07c",
    "function": "#83a598",
    "method": "#83a598",
    "macro": "#fb5440",
    "decorator": "#fb5440",
    "property": "#bcaf91",
    "enumMember": "#fabd2f",
    "parameter": {
      "foreground": "#ebdbb2",
      "fontStyle": "italic"
    },
    "variable": "#ebdbb2",
    "variable.readonly": "#fabd2f",
    "keyword": {
      "foreground": "#d3869b",
      "fontStyle": ""
    },
    "string": "#b8bb26",
    "number": "#fabd2f",
    "regexp": "#fb5440",
    "operator": "#968f8a",
    "*.deprecated": {
      "fontStyle": "strikethrough"
    }
  }
}
