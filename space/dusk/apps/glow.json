{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#f8f8f2",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#bd93f9",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#282a36",
		"background_color": "#bd93f9",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#ff79c6"
	},
	"h3": {
		"prefix": "### ",
		"color": "#8be9fd"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#8be9fd"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#c4c9d7"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#c4c9d7",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#4d4f58",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#8be9fd",
		"underline": true
	},
	"link_text": {
		"color": "#bd93f9",
		"bold": true
	},
	"image": {
		"color": "#ff79c6",
		"underline": true
	},
	"image_text": {
		"color": "#6272a4",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#ff79c6",
		"background_color": "#3d3f49"
	},
	"code_block": {
		"color": "#f8f8f2",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#f8f8f2"
			},
			"error": {
				"color": "#ff5555",
				"background_color": "#3d3f49"
			},
			"comment": {
				"color": "#6272a4"
			},
			"comment_preproc": {
				"color": "#ff79c6"
			},
			"keyword": {
				"color": "#bd93f9"
			},
			"keyword_reserved": {
				"color": "#ff5555"
			},
			"keyword_namespace": {
				"color": "#f1fa8c"
			},
			"keyword_type": {
				"color": "#ff79c6"
			},
			"operator": {
				"color": "#c4c9d7"
			},
			"punctuation": {
				"color": "#8491b8"
			},
			"name": {
				"color": "#f8f8f2"
			},
			"name_builtin": {
				"color": "#f1fa8c"
			},
			"name_tag": {
				"color": "#bd93f9"
			},
			"name_attribute": {
				"color": "#8be9fd"
			},
			"name_class": {
				"color": "#ff79c6",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#f1fa8c"
			},
			"name_exception": {
				"color": "#ff5555"
			},
			"name_function": {
				"color": "#8be9fd"
			},
			"name_other": {
				"color": "#f8f8f2"
			},
			"literal": {
				"color": "#c4c9d7"
			},
			"literal_number": {
				"color": "#f1fa8c"
			},
			"literal_date": {
				"color": "#c4c9d7"
			},
			"literal_string": {
				"color": "#50fa7b"
			},
			"literal_string_escape": {
				"color": "#ff79c6"
			},
			"generic_deleted": {
				"color": "#ff5555"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#50fa7b"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#8491b8"
			},
			"background": {
				"background_color": "#32343f"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
