{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#f2f8ee",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#f5e663",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#0b2d1d",
		"background_color": "#f5e663",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#f5e663"
	},
	"h3": {
		"prefix": "### ",
		"color": "#a0c3af"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#a0c3af"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#d5edd7"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#d5edd7",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#648971",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#a0c3af",
		"underline": true
	},
	"link_text": {
		"color": "#f5e663",
		"bold": true
	},
	"image": {
		"color": "#bea296",
		"underline": true
	},
	"image_text": {
		"color": "#7fa48a",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#bea296",
		"background_color": "#1d5738"
	},
	"code_block": {
		"color": "#f2f8ee",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#f2f8ee"
			},
			"error": {
				"color": "#ff7a5a",
				"background_color": "#1d5738"
			},
			"comment": {
				"color": "#7fa48a"
			},
			"comment_preproc": {
				"color": "#bea296"
			},
			"keyword": {
				"color": "#f5e663"
			},
			"keyword_reserved": {
				"color": "#ff7a5a"
			},
			"keyword_namespace": {
				"color": "#fab05e"
			},
			"keyword_type": {
				"color": "#6fd3e0"
			},
			"operator": {
				"color": "#d5edd7"
			},
			"punctuation": {
				"color": "#bde4c4"
			},
			"name": {
				"color": "#f2f8ee"
			},
			"name_builtin": {
				"color": "#fab05e"
			},
			"name_tag": {
				"color": "#f5e663"
			},
			"name_attribute": {
				"color": "#a0c3af"
			},
			"name_class": {
				"color": "#6fd3e0",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#fab05e"
			},
			"name_exception": {
				"color": "#ff7a5a"
			},
			"name_function": {
				"color": "#a0c3af"
			},
			"name_other": {
				"color": "#f2f8ee"
			},
			"literal": {
				"color": "#d5edd7"
			},
			"literal_number": {
				"color": "#fab05e"
			},
			"literal_date": {
				"color": "#d5edd7"
			},
			"literal_string": {
				"color": "#8ee06a"
			},
			"literal_string_escape": {
				"color": "#bea296"
			},
			"generic_deleted": {
				"color": "#ff7a5a"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#8ee06a"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#bde4c4"
			},
			"background": {
				"background_color": "#15442c"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
