{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#f6eefa",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#ffb347",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#24103d",
		"background_color": "#ffb347",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#ffb347"
	},
	"h3": {
		"prefix": "### ",
		"color": "#bca1cd"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#bca1cd"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#e6d4f2"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#e6d4f2",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#836899",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#bca1cd",
		"underline": true
	},
	"link_text": {
		"color": "#ffb347",
		"bold": true
	},
	"image": {
		"color": "#c598ac",
		"underline": true
	},
	"image_text": {
		"color": "#9a82ae",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#c598ac",
		"background_color": "#4a216a"
	},
	"code_block": {
		"color": "#f6eefa",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#f6eefa"
			},
			"error": {
				"color": "#ff6a7a",
				"background_color": "#4a216a"
			},
			"comment": {
				"color": "#9a82ae"
			},
			"comment_preproc": {
				"color": "#c598ac"
			},
			"keyword": {
				"color": "#ffb347"
			},
			"keyword_reserved": {
				"color": "#ff6a7a"
			},
			"keyword_namespace": {
				"color": "#ff8e60"
			},
			"keyword_type": {
				"color": "#7fd0e8"
			},
			"operator": {
				"color": "#e6d4f2"
			},
			"punctuation": {
				"color": "#d9bfeb"
			},
			"name": {
				"color": "#f6eefa"
			},
			"name_builtin": {
				"color": "#ff8e60"
			},
			"name_tag": {
				"color": "#ffb347"
			},
			"name_attribute": {
				"color": "#bca1cd"
			},
			"name_class": {
				"color": "#7fd0e8",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#ff8e60"
			},
			"name_exception": {
				"color": "#ff6a7a"
			},
			"name_function": {
				"color": "#bca1cd"
			},
			"name_other": {
				"color": "#f6eefa"
			},
			"literal": {
				"color": "#e6d4f2"
			},
			"literal_number": {
				"color": "#ff8e60"
			},
			"literal_date": {
				"color": "#e6d4f2"
			},
			"literal_string": {
				"color": "#7ee08a"
			},
			"literal_string_escape": {
				"color": "#c598ac"
			},
			"generic_deleted": {
				"color": "#ff6a7a"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#7ee08a"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#d9bfeb"
			},
			"background": {
				"background_color": "#391956"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
