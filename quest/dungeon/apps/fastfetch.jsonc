// Quest Dungeon: omarchy-themes/rices/quest/build.py
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/quest-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;255;59;48",
      "title": "38;2;217;203;176",
      "output": "38;2;236;224;200",
      "separator": "38;2;122;42;42"
    },
    "key": {
      "width": 8
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 10,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;224;69;58",
        "yellow": "38;2;255;59;48",
        "red": "38;2;255;59;48"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;255;59;48m▶ \u001b[38;2;217;203;176m† СВИТОК ПРОКЛЯТОГО †"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;122;42;42m══════════════════════════"
    },
    {
      "type": "title",
      "key": "HERO",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "CLASS",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "WEAPON",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "SPELL",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "EXP"
    },
    {
      "type": "battery",
      "key": "HP",
      "format": "{capacity-bar} {capacity}"
    },
    {
      "type": "memory",
      "key": "MP",
      "format": "{percentage-bar} {used}"
    },
    {
      "type": "disk",
      "key": "GOLD",
      "format": "{size-available} free"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;18;4;6m   \u001b[48;2;58;13;18m   \u001b[48;2;122;42;42m   \u001b[48;2;255;59;48m   \u001b[48;2;224;69;58m   \u001b[48;2;154;122;232m   \u001b[48;2;255;59;48m   \u001b[48;2;217;203;176m   \u001b[0m"
    }
  ]
}
