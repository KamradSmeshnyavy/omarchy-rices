  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#968568",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#b0302a"
      }
    },
    {
      "scope": [
        "keyword.control.flow",
        "keyword.control.return"
      ],
      "settings": {
        "foreground": "#b0302a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#3d7a2a"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#74435c"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language"
      ],
      "settings": {
        "foreground": "#9a5a14"
      }
    },
    {
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#6a3a8a"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#2a5a9a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#706c60"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "entity.other.attribute-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#513f28"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#2e2216"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2e2216",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#b0302a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#6e5636"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#b0302a"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "entity.name.function.macro",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#74435c"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#b0302a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#2e2216",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#2e2216",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#706c60",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.list.unnumbered",
        "markup.list.numbered",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#b0302a"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6e5636",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#3d7a2a"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#b0302a"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#2a5a9a"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b0302a"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#2a5a9a",
      "fontStyle": ""
    },
    "interface": {
      "foreground": "#2a5a9a",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#2a5a9a",
      "fontStyle": ""
    },
    "struct": {
      "foreground": "#2a5a9a",
      "fontStyle": ""
    },
    "type": {
      "foreground": "#2a5a9a",
      "fontStyle": ""
    },
    "typeParameter": {
      "foreground": "#2a5a9a",
      "fontStyle": "italic"
    },
    "namespace": "#2a5a9a",
    "function": "#706c60",
    "method": "#706c60",
    "macro": "#74435c",
    "decorator": "#74435c",
    "property": "#513f28",
    "enumMember": "#6a3a8a",
    "parameter": {
      "foreground": "#2e2216",
      "fontStyle": "italic"
    },
    "variable": "#2e2216",
    "variable.readonly": "#6a3a8a",
    "keyword": {
      "foreground": "#b0302a",
      "fontStyle": ""
    },
    "string": "#3d7a2a",
    "number": "#9a5a14",
    "regexp": "#74435c",
    "operator": "#6e5636",
    "*.deprecated": {
      "fontStyle": "strikethrough"
    }
  }
}
