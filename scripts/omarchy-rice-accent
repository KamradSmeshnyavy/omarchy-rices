#!/usr/bin/python3
"""
Акцент райса: тема текущего варианта, у которой заменён только акцент. Нужен райсам без своего выбора цвета
(у Space — миры, у Retro CRT и Modern — свои omarchy-*-colors); выбирается на странице COLORS панели настроек.

  omarchy-rice-accent swatches            цвета-кандидаты: 16 цветов темы и ~8 цветов текущих обоев (JSON)
  omarchy-rice-accent set '#rrggbb'       собрать <тема>-accent с этим акцентом и применить (обои не меняются)
  omarchy-rice-accent reset               вернуть тему, от которой собран акцент (копию с акцентом — удалить)
  omarchy-rice-accent dump                текущее состояние (JSON): base, accent — для профилей панели настроек
  omarchy-rice-accent --state ФАЙЛ.json   собрать из сохранённого профиля (поле accentState)

Тема — ~/.config/omarchy/themes/<тема>-accent (руками не править): файлы темы копией, картинки и обои — ссылками.
В colors.toml меняется accent (и cursor / hyprland_active_border, если были равны акценту). В остальных файлах темы
старый акцент меняется на новый, только если этот цвет в colors.toml больше ни у кого не стоит (у монохромных тем
акцент часто совпадает с текстом — тогда трогаем только colors.toml, остальное Omarchy соберёт из шаблонов).
"""
import colorsys
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

HOME = Path.home()
THEMES = HOME / ".config/omarchy/themes"
LOCAL_BG = HOME / ".config/omarchy/backgrounds"
STATE = HOME / ".local/state/omarchy"
CURRENT = STATE / "current"
CACHE = HOME / ".cache/omarchy/rice-accent"
OMARCHY_THEMES = Path(os.environ.get("OMARCHY_PATH", HOME / ".local/share/omarchy")) / "themes"
MARKER = ".omarchy-rice-accent.json"
SUFFIX = "-accent"
TEXT = {".toml", ".conf", ".css", ".json", ".lua", ".js", ".ini", ".yaml", ".yml", ".theme", ".md", ".kdl", ".rasi",
        ".scss", ".qss", ".xml", ".txt", ".sh", ""}
NAMED = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
HEX = re.compile(r"^#[0-9a-fA-F]{6}$")


def die(msg):
    print(f"omarchy-rice-accent: {msg}", file=sys.stderr)
    sys.exit(1)


def current_name():
    try:
        return (CURRENT / "theme.name").read_text().strip()
    except OSError:
        return ""


def theme_dir(name):
    for base in (THEMES, OMARCHY_THEMES):
        if (base / name / "colors.toml").is_file():
            return base / name
    return None


def marker(name):
    try:
        return json.loads((THEMES / name / MARKER).read_text())
    except (OSError, ValueError):
        return None


def parse(text):
    out = {}
    for ln in text.splitlines():
        m = re.match(r'\s*([A-Za-z0-9_]+)\s*=\s*"(#[0-9a-fA-F]{6})', ln)
        if m:
            out[m.group(1)] = m.group(2).lower()
    return out


def base_of(name):
    """Тема, от которой строится акцент: у нашей <тема>-accent — та, что в маркере."""
    m = marker(name) if name.endswith(SUFFIX) else None
    return m.get("base") if m else name


def theme_colors(name):
    d = theme_dir(name)
    if not d:
        return {}
    return parse((d / "colors.toml").read_text(errors="ignore"))


def palette(c):
    """16 цветов терминала в порядке color0…15 (или именованные ключи) — для ряда «ТЕМА»."""
    out = []
    for i in range(16):
        v = c.get(f"color{i}") or c.get((NAMED[i % 8] if i < 8 else "bright_" + NAMED[i % 8]))
        if v:
            out.append(v)
    for k in ("orange", "brown", "accent"):
        if c.get(k):
            out.append(c[k])
    seen, res = set(), []
    for v in out:
        if v not in seen and v != c.get("background"):
            seen.add(v)
            res.append(v)
    return res[:16]


def hsl_hex(h, s, l):
    r, g, b = colorsys.hls_to_rgb((h % 360) / 360, l, s)
    return "#" + "".join(f"{round(x * 255):02x}" for x in (r, g, b))


def wall_colors():
    """~8 заметных цветов текущих обоев (кластеры Iris), кэш по пути и времени файла."""
    try:
        img = (CURRENT / "background").resolve()
        st = img.stat()
    except OSError:
        return []
    key = hashlib.md5(f"{img}:{st.st_mtime_ns}".encode()).hexdigest()
    f = CACHE / f"{key}.json"
    try:
        return json.loads(f.read_text())
    except (OSError, ValueError):
        pass
    try:
        import wallpaper_colors as wc
        _, clusters = wc.iris(img, clusters=True)
    except Exception as e:  # noqa: BLE001 — нет numpy / битая картинка: просто без ряда обоев
        print(f"обои: {e}", file=sys.stderr)
        return []
    # заметные и цветные: вес — масса кластера × насыщенность; почти одинаковые не повторяем
    clusters = sorted(clusters, key=lambda c: -float(c.get("mass", 0)) * (0.2 + float(c.get("s", 0))))
    out = []
    for c in clusters:
        hx = hsl_hex(float(c.get("h", 0)), min(1, float(c.get("s", 0))), min(1, float(c.get("l", 0))))
        rgb = [int(hx[i:i + 2], 16) for i in (1, 3, 5)]
        if all(sum(abs(x - int(o[i:i + 2], 16)) for x, i in zip(rgb, (1, 3, 5))) > 48 for o in out):
            out.append(hx)
        if len(out) >= 8:
            break
    CACHE.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps(out))
    return out


def swatches():
    name = current_name()
    base = base_of(name)
    cur_file = CURRENT / "theme/colors.toml"
    cur_c = parse(cur_file.read_text(errors="ignore")) if cur_file.is_file() else {}
    c = theme_colors(base) or cur_c
    cur = cur_c.get("accent", "")
    m = marker(name) if name.endswith(SUFFIX) else None
    return {"theme": palette(c), "wall": wall_colors(), "accent": cur, "base": base, "baseAccent": c.get("accent", ""),
            "custom": bool(m), "name": name}


def is_text(p):
    if p.suffix.lower() not in TEXT:
        return False
    try:
        p.read_text()
        return True
    except (UnicodeDecodeError, OSError):
        return False


def build(base, accent):
    accent = accent.lower()
    if not HEX.match(accent):
        die(f"не цвет: {accent}")
    src = theme_dir(base)
    if not src:
        die(f"нет темы {base}")
    src = src.resolve()
    name = base + SUFFIX
    target = THEMES / name
    if target.is_symlink() or (target.exists() and not (target / MARKER).exists()):
        die(f"{target} создан не этим скриптом — не трогаю")
    old_c = parse((src / "colors.toml").read_text(errors="ignore"))
    old = old_c.get("accent", "")
    # старый акцент в других файлах меняем, только если он в colors.toml ни у кого больше не стоит
    shared = [k for k, v in old_c.items() if v == old and k not in ("accent", "cursor", "hyprland_active_border")]
    swap_files = bool(old) and not shared
    THEMES.mkdir(parents=True, exist_ok=True)
    tmp = Path(tempfile.mkdtemp(prefix=f".{name}-", dir=THEMES))
    try:
        tmp.chmod(0o755)
        for p in src.rglob("*"):
            rel = p.relative_to(src)
            if rel.parts and rel.parts[0] == "backgrounds":
                continue
            dst = tmp / rel
            if p.is_dir() and not p.is_symlink():
                dst.mkdir(parents=True, exist_ok=True)
                continue
            dst.parent.mkdir(parents=True, exist_ok=True)
            if p.name == "colors.toml" and len(rel.parts) == 1:
                text = p.read_text()
                for k in ("accent", "cursor", "hyprland_active_border"):
                    if k == "accent" or old_c.get(k) == old:
                        text = re.sub(rf'(?m)^(\s*{k}\s*=\s*")#[0-9a-fA-F]{{6}}', lambda m: m.group(1) + accent, text)
                dst.write_text(text)
            elif swap_files and p.is_file() and is_text(p):
                text = p.read_text()
                text = re.sub(re.escape(old), accent, text, flags=re.I)
                text = re.sub(re.escape(old[1:]), accent[1:], text, flags=re.I) if len(old) == 7 else text
                dst.write_text(text)
            else:
                dst.symlink_to(p.resolve())
        # обои: ссылками на обои темы и на свои обои Omarchy для неё
        bg = tmp / "backgrounds"
        bg.mkdir(exist_ok=True)
        for d in (src / "backgrounds", LOCAL_BG / base):
            if d.is_dir():
                for w in sorted(d.iterdir()):
                    if w.is_file() and not (bg / w.name).exists():
                        (bg / w.name).symlink_to(w.resolve())
        info = {"base": base, "accent": accent, "was": old}
        (tmp / MARKER).write_text(json.dumps(info) + "\n")
        (tmp / "README.md").write_text(f"# {name}\n\nТема {base} с акцентом {accent}. Пересоздаётся `omarchy-rice-accent`, "
                                       "руками не править.\n")
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    prev = None
    if target.exists():
        prev = target.with_name(f".{name}-old-{os.getpid()}")
        target.rename(prev)
    tmp.rename(target)
    if prev:
        shutil.rmtree(prev)
    # прежние <тема>-accent от других тем: оставляем только эту (каждая с нашим маркером)
    for d in THEMES.glob(f"*{SUFFIX}"):
        if d.name != name and not d.is_symlink() and (d / MARKER).is_file() and d.name != current_name():
            shutil.rmtree(d)
    return name


def theme_set(name):
    env = dict(os.environ, OMARCHY_THEME_SKIP_BACKGROUND="1")
    subprocess.run(["omarchy-theme-set", name], check=True, env=env)
    bg = CURRENT / "background"
    # обои не меняем: если theme-set всё-таки сменил — вернуть прежние
    return bg


def set_accent(hex_color, base=None):
    bg_before = (CURRENT / "background").resolve() if (CURRENT / "background").exists() else None
    base = base or base_of(current_name())
    if not base:
        die("не знаю текущую тему")
    name = build(base, hex_color)
    theme_set(name)
    if bg_before and (CURRENT / "background").exists() and (CURRENT / "background").resolve() != bg_before:
        subprocess.run(["omarchy-theme-bg-set", str(bg_before)], check=False)
    print(f"{name}: {hex_color}")


def reset():
    name = current_name()
    m = marker(name) if name.endswith(SUFFIX) else None
    if not m:
        return
    bg_before = (CURRENT / "background").resolve() if (CURRENT / "background").exists() else None
    theme_set(m["base"])
    if bg_before and (CURRENT / "background").exists() and (CURRENT / "background").resolve() != bg_before:
        subprocess.run(["omarchy-theme-bg-set", str(bg_before)], check=False)
    # копия с акцентом больше не нужна (наш маркер — значит, наша)
    d = THEMES / name
    if not d.is_symlink() and (d / MARKER).is_file() and current_name() != name:
        shutil.rmtree(d)


def dump():
    name = current_name()
    m = marker(name) if name.endswith(SUFFIX) else None
    return {"base": m["base"], "accent": m["accent"]} if m else {}


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    if a[0] == "swatches":
        print(json.dumps(swatches()))
    elif a[0] == "set" and len(a) > 1:
        set_accent(a[1])
    elif a[0] == "reset":
        reset()
    elif a[0] == "dump":
        print(json.dumps(dump()))
    elif a[0] == "--state" and len(a) > 1:
        try:
            d = json.loads(Path(a[1]).read_text()).get("accentState") or {}
        except (OSError, ValueError):
            die(f"не читается {a[1]}")
        if d.get("base") and d.get("accent"):
            set_accent(d["accent"], d["base"])
    else:
        die("команды: swatches | set '#rrggbb' | reset | dump | --state ФАЙЛ")


if __name__ == "__main__":
    main()
