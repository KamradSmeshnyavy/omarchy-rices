{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#929a9c",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#fa8f44",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#0f2024",
		"background_color": "#fa8f44",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#b26e4e"
	},
	"h3": {
		"prefix": "### ",
		"color": "#aa9473"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#aa9473"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#828d90"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#828d90",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#213135",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#aa9473",
		"underline": true
	},
	"link_text": {
		"color": "#fa8f44",
		"bold": true
	},
	"image": {
		"color": "#b77759",
		"underline": true
	},
	"image_text": {
		"color": "#5e7074",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#b77759",
		"background_color": "#1d2d31"
	},
	"code_block": {
		"color": "#929a9c",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#929a9c"
			},
			"error": {
				"color": "#a5806e",
				"background_color": "#1d2d31"
			},
			"comment": {
				"color": "#5e7074"
			},
			"comment_preproc": {
				"color": "#b77759"
			},
			"keyword": {
				"color": "#fa8f44"
			},
			"keyword_reserved": {
				"color": "#a5806e"
			},
			"keyword_namespace": {
				"color": "#6a9182"
			},
			"keyword_type": {
				"color": "#e5965f"
			},
			"operator": {
				"color": "#828d90"
			},
			"punctuation": {
				"color": "#838c8f"
			},
			"name": {
				"color": "#929a9c"
			},
			"name_builtin": {
				"color": "#6a9182"
			},
			"name_tag": {
				"color": "#fa8f44"
			},
			"name_attribute": {
				"color": "#aa9473"
			},
			"name_class": {
				"color": "#e5965f",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#6a9182"
			},
			"name_exception": {
				"color": "#a5806e"
			},
			"name_function": {
				"color": "#aa9473"
			},
			"name_other": {
				"color": "#929a9c"
			},
			"literal": {
				"color": "#828d90"
			},
			"literal_number": {
				"color": "#6a9182"
			},
			"literal_date": {
				"color": "#828d90"
			},
			"literal_string": {
				"color": "#479189"
			},
			"literal_string_escape": {
				"color": "#b77759"
			},
			"generic_deleted": {
				"color": "#a5806e"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#479189"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#838c8f"
			},
			"background": {
				"background_color": "#17272b"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
