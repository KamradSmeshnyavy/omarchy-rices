{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#91959b",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#827aa7",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#0e1721",
		"background_color": "#827aa7",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#314c6c"
	},
	"h3": {
		"prefix": "### ",
		"color": "#8081a9"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#8081a9"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#81878f"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#81878f",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#202932",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#8081a9",
		"underline": true
	},
	"link_text": {
		"color": "#827aa7",
		"bold": true
	},
	"image": {
		"color": "#718399",
		"underline": true
	},
	"image_text": {
		"color": "#5d6772",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#718399",
		"background_color": "#1c252e"
	},
	"code_block": {
		"color": "#91959b",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#91959b"
			},
			"error": {
				"color": "#7a8695",
				"background_color": "#1c252e"
			},
			"comment": {
				"color": "#5d6772"
			},
			"comment_preproc": {
				"color": "#718399"
			},
			"keyword": {
				"color": "#827aa7"
			},
			"keyword_reserved": {
				"color": "#7a8695"
			},
			"keyword_namespace": {
				"color": "#5a86a5"
			},
			"keyword_type": {
				"color": "#a073b1"
			},
			"operator": {
				"color": "#81878f"
			},
			"punctuation": {
				"color": "#7b8086"
			},
			"name": {
				"color": "#91959b"
			},
			"name_builtin": {
				"color": "#5a86a5"
			},
			"name_tag": {
				"color": "#827aa7"
			},
			"name_attribute": {
				"color": "#8081a9"
			},
			"name_class": {
				"color": "#a073b1",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#5a86a5"
			},
			"name_exception": {
				"color": "#7a8695"
			},
			"name_function": {
				"color": "#8081a9"
			},
			"name_other": {
				"color": "#91959b"
			},
			"literal": {
				"color": "#81878f"
			},
			"literal_number": {
				"color": "#5a86a5"
			},
			"literal_date": {
				"color": "#81878f"
			},
			"literal_string": {
				"color": "#8584a0"
			},
			"literal_string_escape": {
				"color": "#718399"
			},
			"generic_deleted": {
				"color": "#7a8695"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#8584a0"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#7b8086"
			},
			"background": {
				"background_color": "#161f28"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
