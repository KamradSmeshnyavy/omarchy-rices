{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#95989f",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#a7a57b",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#1e1f25",
		"background_color": "#a7a57b",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#817e63"
	},
	"h3": {
		"prefix": "### ",
		"color": "#a09d76"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#a09d76"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#868994"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#868994",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#2f3036",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#a09d76",
		"underline": true
	},
	"link_text": {
		"color": "#a7a57b",
		"bold": true
	},
	"image": {
		"color": "#908d75",
		"underline": true
	},
	"image_text": {
		"color": "#6c7081",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#908d75",
		"background_color": "#2b2c32"
	},
	"code_block": {
		"color": "#95989f",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#95989f"
			},
			"error": {
				"color": "#8a8a7a",
				"background_color": "#2b2c32"
			},
			"comment": {
				"color": "#6c7081"
			},
			"comment_preproc": {
				"color": "#908d75"
			},
			"keyword": {
				"color": "#a7a57b"
			},
			"keyword_reserved": {
				"color": "#8a8a7a"
			},
			"keyword_namespace": {
				"color": "#90916f"
			},
			"keyword_type": {
				"color": "#b4b289"
			},
			"operator": {
				"color": "#868994"
			},
			"punctuation": {
				"color": "#8a8b91"
			},
			"name": {
				"color": "#95989f"
			},
			"name_builtin": {
				"color": "#90916f"
			},
			"name_tag": {
				"color": "#a7a57b"
			},
			"name_attribute": {
				"color": "#a09d76"
			},
			"name_class": {
				"color": "#b4b289",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#90916f"
			},
			"name_exception": {
				"color": "#8a8a7a"
			},
			"name_function": {
				"color": "#a09d76"
			},
			"name_other": {
				"color": "#95989f"
			},
			"literal": {
				"color": "#868994"
			},
			"literal_number": {
				"color": "#90916f"
			},
			"literal_date": {
				"color": "#868994"
			},
			"literal_string": {
				"color": "#818b74"
			},
			"literal_string_escape": {
				"color": "#908d75"
			},
			"generic_deleted": {
				"color": "#8a8a7a"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#818b74"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#8a8b91"
			},
			"background": {
				"background_color": "#25262c"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
